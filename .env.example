# PK CONTROL — local development settings
PK_CONTROL_ENVIRONMENT=development
PK_CONTROL_DATABASE_URL=sqlite:///./data/pk_control.db
PK_CONTROL_CORS_ORIGINS=http://localhost:5173
PK_CONTROL_DOCUMENTS_ROOT=\\\\server\\PK_CONTROL\\Documents
PK_CONTROL_BACKUPS_ROOT=\\\\server\\PK_CONTROL\\Backups

# Authentication: set strong unique values only in local .env / deployment secrets.
PK_CONTROL_JWT_SECRET=
PK_CONTROL_ACCESS_TOKEN_MINUTES=30
PK_CONTROL_INITIAL_ADMIN_LOGIN=
PK_CONTROL_INITIAL_ADMIN_PASSWORD=
PK_CONTROL_INITIAL_ADMIN_NAME=Администратор
